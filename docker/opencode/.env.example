# OpenCode 容器环境变量样例
# 复制为 .env 后填入真实值；.env 已在 .gitignore 里，不会被提交

# ── 火山方舟 Agent Plan（主力）─────────────────────────
# 从 ~/.config/opencode/opencode.json → provider["agent-plan"].options.apiKey 取
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# ── 其他 provider（按需，留空则不启用）──────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ZHIPU_API_KEY=

# ── opencode server 参数 ───────────────────────────────
# 前端开发地址，多个用逗号分隔
OPENCODE_CORS=http://localhost:5173
# 镜像里安装的 opencode 版本（latest / 1.18.4 / ...）
OPENCODE_VERSION=latest
