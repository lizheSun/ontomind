# --- 感知层加密（T01） ---
# 使用 python backend/scripts/gen_fernet.py 生成 44 字符 urlsafe-base64 密钥
# 支持逗号分隔多个密钥用于轮换（第一个是加密主 key，其余用于兼容解密）
FERNET_KEY=

# === DataOps · Doris 默认数据源（可选种子）===
DORIS_SOURCE_NAME=Doris 数仓
DORIS_HOST=
DORIS_PORT=9030
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DATABASE=
DORIS_CHARSET=utf8mb4

# === LLM（元数据标注 / 本体生成，OpenAI 兼容）===
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=120
LLM_MAX_CONCURRENCY=4
